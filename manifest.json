{
  "manifest_version": 3,
  "name": "내 문장 모음",
  "version": "1.0.0",
  "description": "웹페이지에서 마음에 드는 문장을 우클릭으로 저장하고, 메모와 함께 모아 보세요.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "내 문장 모음",
    "default_popup": "popup.html"
  }
}
